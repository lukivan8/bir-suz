{
  "manifest_version": 3,
  "name": "Bir Söz",
  "version": "0.1.0",
  "description": "Low-friction Kazakh micro-learning browser extension.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.tsx-loader-B9U4KIap.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard.html",
  "permissions": [
    "storage",
    "tabs",
    "idle"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "demo-trigger": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Demo Trigger"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/web-C_QG9otm.js",
        "assets/content.tsx-DPO8Z8Ai.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
